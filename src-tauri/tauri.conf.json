{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairo",
  "version": "0.3.0",
  "identifier": "dev.ethone.ethra",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairo",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Kairo overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "width": 1920,
        "height": 1080
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-splash.bmp",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "template": "installer/installer.nsi"
      }
    },
    "publisher": "Rub19",
    "shortDescription": "Kairo, tracker gratuit pour League of Legends, VALORANT et Teamfight Tactics",
    "copyright": "Kairo n'est pas approuvé par Riot Games."
  }
}
